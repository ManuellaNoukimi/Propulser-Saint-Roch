# Démonstration locale : aucune clé API obligatoire.
# Copier vers .env.local. Ne jamais y mettre de données à publier.

# Vide : utilise ./data, créé automatiquement. Chemin alternatif facultatif.
COMPLICES_DATA_DIR=
# Vide : utilise .next. Les tests HTTP utilisent .next-test.
COMPLICES_DIST_DIR=
# 0 pour localhost en HTTP. Mettre 1 uniquement derrière HTTPS en production.
COMPLICES_HTTPS=0

# Accès SDC : liste d'identifiants internes séparés par des virgules.
# Vide = aucun compte administrateur autorisé. Ne pas y mettre des courriels.
COMPLICES_SDC_USER_IDS=
# Clé serveur facultative pour l'import SDC. Ne pas la préfixer NEXT_PUBLIC_.
COMPLICES_SDC_API_KEY=
# Code du Midi SIMULÉ, sans valeur commerciale.
COMPLICES_MIDI_CODE=MIDI-DEMO

# Fichiers privés facultatifs. Absents = listes externes vides / repli local.
# Ne pas committer les classeurs du hackathon ou les bases qui en proviennent.
COMPLICES_EVENTS_XLSX=
COMPLICES_ENTREPRISES_XLSX=
COMPLICES_PARKING_GEOJSON=
