{
  "name": "complices",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "demo": "next build && next start -H 0.0.0.0",
    "reset-db": "node -e \"require('fs').rmSync('data',{recursive:true,force:true}); console.log('Base effacée')\"",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --test tests/*.test.cjs",
    "test:http": "node scripts/test-http.cjs",
    "db:prepare": "node --env-file-if-exists=.env.local --conditions=react-server scripts/prepare-db.cjs",
    "demo:seed": "node --env-file-if-exists=.env.local --conditions=react-server scripts/recruiter-demo.cjs",
    "check:repository": "node scripts/check-repository.cjs"
  },
  "dependencies": {
    "@turf/circle": "^7.4.0",
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^5.6.0",
    "next": "16.4.1",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
